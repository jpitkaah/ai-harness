# Local SearXNG settings hold a secret key: copy searxng/settings.example.yml to searxng/settings.yml
searxng/settings.yml

# Benchmarks: third-party data and generated results (see benchmark/README.md to set them up).
# IFBench is cloned from github.com/allenai/IFBench. GPQA's authors ask that its questions are not put online in
# plain text. The results are large, regenerated by the runners, and the GPQA ones contain question text.
benchmark/IFBench/
benchmark/gpqa/
benchmark/results/

# Leftovers
*.bak
